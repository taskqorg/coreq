{
  "contract": "coreq-enrollment/1",
  "product": "agentq",
  "about": "Rejections: incompatible major, wrong scope, changed replay payload, unknown credential, revoked generation after reconnect.",
  "steps": [
    {"at": 0, "route": "/connect/device",
     "request": {"protocol": 2, "product": "agentq", "installation": "inst-a2", "runtime": "wsl", "host_label": "pc-1", "schemas": ["agentq-snapshot/1"]},
     "status": 400, "response": {"protocol": 1, "error": "unsupported_protocol"}},
    {"at": 0, "route": "/connect/device",
     "request": {"protocol": 1, "product": "agentq", "installation": "inst-a2", "runtime": "wsl", "host_label": "pc-1", "schemas": ["agentq-snapshot/1"]},
     "status": 200, "response": {"protocol": 1, "device_code": "$device", "user_code": "$code", "verification_uri": "$uri", "expires_in": 600, "interval": 5}},
    {"at": 10, "browser": "approve", "user_code": "$code", "account": "acct-1", "workspace": "ws-1", "result": "approved"},
    {"at": 11, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device"},
     "status": 200, "response": {"protocol": 1, "credential": "$cred1", "installation": "inst-a2", "generation": 1, "product": "agentq", "workspace": "ws-1", "schemas": ["agentq-snapshot/1"]}},
    {"at": 12, "route": "/connect/ack", "auth": "$cred1", "request": {"protocol": 1},
     "status": 200, "response": {"protocol": 1, "state": "active", "generation": 1}},
    {"at": 13, "route": "/ingest", "auth": "$cred1", "request": {"records": []},
     "status": 400, "response": {"protocol": 1, "error": "unsupported_protocol"}},
    {"at": 14, "route": "/ingest", "auth": "not-a-credential", "request": {"protocol": 1, "records": []},
     "status": 401, "response": {"protocol": 1, "error": "invalid_credential"}},
    {"at": 15, "route": "/ingest", "auth": "$cred1",
     "request": {"protocol": 1, "records": [
       {"schema": "agentq-snapshot/1", "event_id": "ev-1", "observed_at": 15, "payload": {"cpu": 10}},
       {"schema": "serverq-report/1", "event_id": "ev-2", "observed_at": 15, "payload": {}}]},
     "status": 200, "response": {"protocol": 1, "receipts": [
       {"event_id": "ev-1", "state": "accepted"},
       {"event_id": "ev-2", "state": "rejected", "reason": "scope"}]}},
    {"at": 16, "route": "/ingest", "auth": "$cred1",
     "request": {"protocol": 1, "records": [{"schema": "agentq-snapshot/1", "event_id": "ev-1", "observed_at": 15, "payload": {"cpu": 99}}]},
     "status": 200, "response": {"protocol": 1, "receipts": [{"event_id": "ev-1", "state": "rejected", "reason": "replay_mismatch"}]}},
    {"server": "project"},
    {"at": 17, "route": "/connection/receipt", "auth": "$cred1", "request": {"protocol": 1, "event_id": "ev-1"},
     "status": 200, "response": {"protocol": 1, "installation": "inst-a2", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1", "state": "projected"}},
    {"at": 20, "route": "/connection/revoke", "auth": "$cred1", "request": {"protocol": 1},
     "status": 200, "response": {"protocol": 1, "state": "revoked", "generation": 1}},
    {"at": 30, "route": "/connect/device",
     "request": {"protocol": 1, "product": "agentq", "installation": "inst-a2", "runtime": "wsl", "host_label": "pc-1", "schemas": ["agentq-snapshot/1"]},
     "status": 200, "response": {"protocol": 1, "device_code": "$device2", "user_code": "$code2", "verification_uri": "$uri", "expires_in": 600, "interval": 5}},
    {"at": 40, "browser": "approve", "user_code": "$code2", "account": "acct-1", "workspace": "ws-2", "result": "approved"},
    {"at": 41, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device2"},
     "status": 200, "response": {"protocol": 1, "credential": "$cred2", "installation": "inst-a2", "generation": 2, "product": "agentq", "workspace": "ws-2", "schemas": ["agentq-snapshot/1"]}},
    {"at": 42, "route": "/connect/ack", "auth": "$cred2", "request": {"protocol": 1},
     "status": 200, "response": {"protocol": 1, "state": "active", "generation": 2}},
    {"at": 43, "route": "/ingest", "auth": "$cred1",
     "request": {"protocol": 1, "records": [{"schema": "agentq-snapshot/1", "event_id": "ev-3", "observed_at": 18, "payload": {"cpu": 12}}]},
     "status": 401, "response": {"protocol": 1, "error": "revoked"}},
    {"at": 44, "route": "/connection/receipt", "auth": "$cred2", "request": {"protocol": 1, "event_id": "ev-1"},
     "status": 404, "response": {"protocol": 1, "error": "unknown_event"}},
    {"at": 45, "route": "/ingest", "auth": "$cred2",
     "request": {"protocol": 1, "records": [{"schema": "agentq-snapshot/1", "event_id": "ev-1", "observed_at": 45, "payload": {"cpu": 20}}]},
     "status": 200, "response": {"protocol": 1, "receipts": [{"event_id": "ev-1", "state": "accepted"}]}},
    {"server": "project"},
    {"at": 46, "route": "/connection/receipt", "auth": "$cred2", "request": {"protocol": 1, "event_id": "ev-1"},
     "status": 200, "response": {"protocol": 1, "installation": "inst-a2", "generation": 2, "schema": "agentq-snapshot/1", "event_id": "ev-1", "state": "projected"},
     "verify": {"installation": "inst-a2", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1"}, "client": "generation mismatch"}
  ]
}
