{
  "contract": "coreq-enrollment/1",
  "product": "agentq",
  "about": "AgentQ configure operations: an observation grant gets 403 scope; the agentq.configure grant pulls its pending operations with server-set authority (actor, workspace, profiles); an actor or workspace without authority is refused at queue time; a result repeats to the same receipt, a changed result or digest is rejected; resulted and expired operations are no longer pending; revoke ends the pull.",
  "steps": [
    {"at": 0, "route": "/connect/device", "request": {"protocol": 1, "product": "agentq", "installation": "inst-o1", "runtime": "native", "host_label": "mac-1", "schemas": ["agentq-snapshot/1"]}, "status": 200, "response": {"protocol": 1, "device_code": "$device1", "user_code": "$code1", "verification_uri": "$uri", "expires_in": 600, "interval": 5}},
    {"at": 1, "browser": "approve", "user_code": "$code1", "account": "acct-1", "workspace": "ws-1", "result": "approved"},
    {"at": 2, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device1"}, "status": 200, "response": {"protocol": 1, "credential": "$observe", "installation": "inst-o1", "generation": 1, "product": "agentq", "workspace": "ws-1", "schemas": ["agentq-snapshot/1"]}},
    {"at": 3, "route": "/connect/ack", "auth": "$observe", "request": {"protocol": 1}, "status": 200, "response": {"protocol": 1, "state": "active", "generation": 1}},
    {"at": 4, "route": "/operations", "auth": "$observe", "request": {"protocol": 1, "capability": "agentq.configure"}, "status": 403, "response": {"protocol": 1, "error": "scope"}},
    {"at": 10, "route": "/connect/device", "request": {"protocol": 1, "product": "agentq", "installation": "inst-a3", "runtime": "native", "host_label": "mac-1", "schemas": ["agentq-snapshot/1"], "capabilities": ["agentq.configure"]}, "status": 200, "response": {"protocol": 1, "device_code": "$device2", "user_code": "$code2", "verification_uri": "$uri", "expires_in": 600, "interval": 5}},
    {"at": 11, "browser": "approve", "user_code": "$code2", "account": "acct-1", "workspace": "ws-1", "result": "approved"},
    {"at": 12, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device2"}, "status": 200, "response": {"protocol": 1, "credential": "$cred", "installation": "inst-a3", "generation": 1, "product": "agentq", "workspace": "ws-1", "schemas": ["agentq-snapshot/1"], "capabilities": ["agentq.configure"]}},
    {"at": 13, "route": "/connect/ack", "auth": "$cred", "request": {"protocol": 1}, "status": 200, "response": {"protocol": 1, "state": "active", "generation": 1}},
    {"at": 14, "route": "/operations", "auth": "$cred", "request": {"protocol": 1, "capability": "agentq.configure"}, "status": 200, "response": {"protocol": 1, "operations": []}},
    {"server": "queue", "operation": {"operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "capability": "agentq.configure", "installation": "inst-a3", "generation": 1, "expires_at": 300, "digest": "5c900be652c8192b0b669ce9caedcc4f916fe92c1f62191e5e53e7bad8ce881f", "payload": {"schema": 1, "kind": "apply", "changes": [{"profile": "p1", "field": "routing", "value": "direct"}]}, "authority": {"actor": "acct-1", "workspace": "ws-1", "profiles": ["p1"]}}, "result": "queued"},
    {"server": "queue", "operation": {"operation": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "capability": "agentq.configure", "installation": "inst-a3", "generation": 1, "expires_at": 40, "digest": "e8a78547020f0484d6e9be751df5b397645cf1c1ed85502d670aa11944c49f64", "payload": {"schema": 1, "kind": "plan", "changes": [{"profile": "p1", "field": "optimization", "value": "enabled"}]}, "authority": {"actor": "acct-1", "workspace": "ws-1", "profiles": ["p1"]}}, "result": "queued"},
    {"server": "queue", "operation": {"operation": "dddddddddddddddddddddddddddddddd", "capability": "agentq.configure", "installation": "inst-a3", "generation": 1, "expires_at": 40, "digest": "e8a78547020f0484d6e9be751df5b397645cf1c1ed85502d670aa11944c49f64", "payload": {"schema": 1, "kind": "plan", "changes": [{"profile": "p1", "field": "optimization", "value": "enabled"}]}, "authority": {"actor": "acct-9", "workspace": "ws-1", "profiles": ["p1"]}}, "result": "refused"},
    {"server": "queue", "operation": {"operation": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "capability": "agentq.configure", "installation": "inst-a3", "generation": 1, "expires_at": 40, "digest": "e8a78547020f0484d6e9be751df5b397645cf1c1ed85502d670aa11944c49f64", "payload": {"schema": 1, "kind": "plan", "changes": [{"profile": "p1", "field": "optimization", "value": "enabled"}]}, "authority": {"actor": "acct-1", "workspace": "ws-2", "profiles": ["p1"]}}, "result": "refused"},
    {"at": 20, "route": "/operations", "auth": "$cred", "request": {"protocol": 1, "capability": "agentq.configure"}, "status": 200, "response": {"protocol": 1, "operations": [{"operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "capability": "agentq.configure", "installation": "inst-a3", "generation": 1, "expires_at": 300, "digest": "5c900be652c8192b0b669ce9caedcc4f916fe92c1f62191e5e53e7bad8ce881f", "payload": {"schema": 1, "kind": "apply", "changes": [{"profile": "p1", "field": "routing", "value": "direct"}]}, "authority": {"actor": "acct-1", "workspace": "ws-1", "profiles": ["p1"]}}, {"operation": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "capability": "agentq.configure", "installation": "inst-a3", "generation": 1, "expires_at": 40, "digest": "e8a78547020f0484d6e9be751df5b397645cf1c1ed85502d670aa11944c49f64", "payload": {"schema": 1, "kind": "plan", "changes": [{"profile": "p1", "field": "optimization", "value": "enabled"}]}, "authority": {"actor": "acct-1", "workspace": "ws-1", "profiles": ["p1"]}}]}},
    {"at": 21, "route": "/operations", "auth": "$observe", "request": {"protocol": 1, "capability": "agentq.configure"}, "status": 403, "response": {"protocol": 1, "error": "scope"}},
    {"at": 22, "route": "/operations/result", "auth": "$cred", "request": {"protocol": 1, "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "digest": "5c900be652c8192b0b669ce9caedcc4f916fe92c1f62191e5e53e7bad8ce881f", "result": {"schema": 1, "kind": "result", "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "outcome": "applied"}}, "status": 200, "response": {"protocol": 1, "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "state": "accepted"}},
    {"at": 23, "route": "/operations/result", "auth": "$cred", "request": {"protocol": 1, "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "digest": "5c900be652c8192b0b669ce9caedcc4f916fe92c1f62191e5e53e7bad8ce881f", "result": {"schema": 1, "kind": "result", "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "outcome": "applied"}}, "status": 200, "response": {"protocol": 1, "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "state": "accepted"}},
    {"at": 24, "route": "/operations/result", "auth": "$cred", "request": {"protocol": 1, "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "digest": "5c900be652c8192b0b669ce9caedcc4f916fe92c1f62191e5e53e7bad8ce881f", "result": {"schema": 1, "kind": "result", "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "outcome": "rejected"}}, "status": 200, "response": {"protocol": 1, "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "state": "rejected", "reason": "replay_mismatch"}},
    {"at": 25, "route": "/operations/result", "auth": "$cred", "request": {"protocol": 1, "operation": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "digest": "5c900be652c8192b0b669ce9caedcc4f916fe92c1f62191e5e53e7bad8ce881f", "result": {"schema": 1, "kind": "result", "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "outcome": "applied"}}, "status": 200, "response": {"protocol": 1, "operation": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "state": "rejected", "reason": "digest_mismatch"}},
    {"at": 26, "route": "/operations/result", "auth": "$cred", "request": {"protocol": 1, "operation": "cccccccccccccccccccccccccccccccc", "digest": "5c900be652c8192b0b669ce9caedcc4f916fe92c1f62191e5e53e7bad8ce881f", "result": {"schema": 1, "kind": "result", "operation": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "outcome": "applied"}}, "status": 200, "response": {"protocol": 1, "operation": "cccccccccccccccccccccccccccccccc", "state": "rejected", "reason": "unknown_operation"}},
    {"at": 41, "route": "/operations", "auth": "$cred", "request": {"protocol": 1, "capability": "agentq.configure"}, "status": 200, "response": {"protocol": 1, "operations": []}},
    {"at": 50, "route": "/connection/revoke", "auth": "$cred", "request": {"protocol": 1}, "status": 200, "response": {"protocol": 1, "state": "revoked", "generation": 1}},
    {"at": 51, "route": "/operations", "auth": "$cred", "request": {"protocol": 1, "capability": "agentq.configure"}, "status": 401, "response": {"protocol": 1, "error": "revoked"}}
  ]
}
