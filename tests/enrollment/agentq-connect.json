{
  "contract": "coreq-enrollment/1",
  "product": "agentq",
  "about": "C1 first connection: pending, slow-down, approval, lost token and ack replies, ingest, accepted then projected receipt, revoke.",
  "steps": [
    {"at": 0, "route": "/connect/device",
     "request": {"protocol": 1, "product": "agentq", "installation": "inst-a1", "runtime": "native", "host_label": "mac-1", "schemas": ["agentq-snapshot/1"], "future_field": true},
     "status": 200, "response": {"protocol": 1, "device_code": "$device", "user_code": "$code", "verification_uri": "$uri", "expires_in": 600, "interval": 5}},
    {"at": 5, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device"},
     "status": 400, "response": {"protocol": 1, "error": "authorization_pending"}},
    {"at": 7, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device"},
     "status": 400, "response": {"protocol": 1, "error": "slow_down"}},
    {"at": 20, "browser": "approve", "user_code": "$code", "account": "acct-1", "workspace": "ws-1", "result": "approved"},
    {"at": 21, "browser": "approve", "user_code": "$code", "account": "acct-1", "workspace": "ws-1", "result": "already approved"},
    {"at": 22, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device"},
     "status": 200, "response": {"protocol": 1, "credential": "$cred", "installation": "inst-a1", "generation": 1, "product": "agentq", "workspace": "ws-1", "schemas": ["agentq-snapshot/1"]}},
    {"at": 30, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device"},
     "status": 200, "response": {"protocol": 1, "credential": "$cred", "installation": "inst-a1", "generation": 1, "product": "agentq", "workspace": "ws-1", "schemas": ["agentq-snapshot/1"]}},
    {"at": 31, "route": "/ingest", "auth": "$cred",
     "request": {"protocol": 1, "records": [{"schema": "agentq-snapshot/1", "event_id": "ev-1", "observed_at": 31, "payload": {"version": "1.0.0"}}]},
     "status": 403, "response": {"protocol": 1, "error": "not_active"}},
    {"at": 32, "route": "/connect/ack", "auth": "$cred", "request": {"protocol": 1},
     "status": 200, "response": {"protocol": 1, "state": "active", "generation": 1}},
    {"at": 33, "route": "/connect/ack", "auth": "$cred", "request": {"protocol": 1},
     "status": 200, "response": {"protocol": 1, "state": "active", "generation": 1}},
    {"at": 34, "route": "/connect/token", "request": {"protocol": 1, "device_code": "$device"},
     "status": 400, "response": {"protocol": 1, "error": "invalid_grant"}},
    {"at": 35, "route": "/ingest", "auth": "$cred",
     "request": {"protocol": 1, "records": [{"schema": "agentq-snapshot/1", "event_id": "ev-1", "observed_at": 31, "payload": {"version": "1.0.0"}}]},
     "status": 200, "response": {"protocol": 1, "receipts": [{"event_id": "ev-1", "state": "accepted"}]}},
    {"at": 36, "route": "/ingest", "auth": "$cred",
     "request": {"protocol": 1, "records": [{"schema": "agentq-snapshot/1", "event_id": "ev-1", "observed_at": 31, "payload": {"version": "1.0.0"}}]},
     "status": 200, "response": {"protocol": 1, "receipts": [{"event_id": "ev-1", "state": "accepted"}]}},
    {"at": 37, "route": "/connection/receipt", "auth": "$cred", "request": {"protocol": 1, "event_id": "ev-1"},
     "status": 200, "response": {"protocol": 1, "installation": "inst-a1", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1", "state": "accepted"},
     "verify": {"installation": "inst-a1", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1"}, "client": "not projected: accepted"},
    {"server": "project"},
    {"at": 39, "route": "/connection/receipt", "auth": "$cred", "request": {"protocol": 1, "event_id": "ev-1"},
     "status": 200, "response": {"protocol": 1, "installation": "inst-a1", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1", "state": "projected"},
     "verify": {"installation": "inst-a1", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1"}, "client": "connected"},
    {"at": 40, "route": "/connection/receipt", "auth": "$cred", "request": {"protocol": 1, "event_id": "ev-1"},
     "status": 200, "response": {"protocol": 1, "installation": "inst-a1", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1", "state": "projected"},
     "verify": {"installation": "inst-other", "generation": 1, "schema": "agentq-snapshot/1", "event_id": "ev-1"}, "client": "installation mismatch"},
    {"at": 41, "route": "/connection/receipt", "auth": "$cred", "request": {"protocol": 1, "event_id": "ev-9"},
     "status": 404, "response": {"protocol": 1, "error": "unknown_event"}},
    {"at": 50, "route": "/connection/revoke", "auth": "$cred", "request": {"protocol": 1},
     "status": 200, "response": {"protocol": 1, "state": "revoked", "generation": 1}},
    {"at": 51, "route": "/connection/revoke", "auth": "$cred", "request": {"protocol": 1},
     "status": 200, "response": {"protocol": 1, "state": "revoked", "generation": 1}},
    {"at": 52, "route": "/ingest", "auth": "$cred",
     "request": {"protocol": 1, "records": [{"schema": "agentq-snapshot/1", "event_id": "ev-2", "observed_at": 52, "payload": {}}]},
     "status": 401, "response": {"protocol": 1, "error": "revoked"}}
  ]
}
